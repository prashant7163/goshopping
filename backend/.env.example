# Backend environment. Copy to backend/.env before running the server.

# ---- Server ----
APP_ENV=development
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=debug

# ---- Database ----
# Must line up with the root .env used by docker-compose.
DATABASE_URL=postgres://goshopping:goshopping@localhost:5432/goshopping?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---- Auth ----
# Dev-only secret. Generate a real one for any deployed environment:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-replace-me
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# ---- Sessions ----
# Background reaper deletes session rows this long after they expire.
SESSION_REAP_INTERVAL=24h
SESSION_REAP_GRACE=168h

# ---- CORS ----
# Comma-separated. Must match the Vite dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
